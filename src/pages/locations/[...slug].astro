---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('locations');
  return entries.map(entry => {
    const slug = entry.id.replace(/\.(md|mdx)$/, '');
    const cityFolder = slug.split('/')[0];

    return {
      params: { slug },
      props: { entry, cityFolder },
    };
  });
}

const { entry, cityFolder } = Astro.props;
const { Content } = await entry.render();

const formattedDate = entry.data.pubDate 
  ? new Date(entry.data.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : null;
---

<BaseLayout title={entry.data.title}>
  <main class="max-w-3xl mx-auto px-4 py-12">
    <div class="mb-6">
      <a href={`/locations/${cityFolder}`} class="text-sm font-medium text-[#C59B27] hover:underline">&larr; Back to {entry.data.city || cityFolder} Hub</a>
    </div>
    
    <!-- Added space-y-8 and prose heading spacing adjustments -->
    <article class="prose lg:prose-lg max-w-none space-y-6 [&>h2]:mt-10 [&>h2]:pt-4">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 mb-4">
        {entry.data.title}
      </h1>

      {formattedDate && (
        <div class="mb-8">
          <span class="inline-block px-3 py-1 text-xs font-semibold text-amber-800 bg-amber-100 rounded-full">
            Published: {formattedDate}
          </span>
        </div>
      )}

      <Content />
    </article>
  </main>
</BaseLayout>