---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { city: 'pembroke-pines' }, props: { cityName: 'Pembroke Pines' } },
    { params: { city: 'miramar' }, props: { cityName: 'Miramar' } },
    { params: { city: 'davie' }, props: { cityName: 'Davie' } },
    { params: { city: 'weston' }, props: { cityName: 'Weston' } },
  ];
}

const { city } = Astro.params;
const { cityName } = Astro.props;

// Fetch all entries from the locations collection
const allLocations = await getCollection('locations');

// Filter entries matching the city and sort by date (newest first)
const posts = allLocations
  .filter(entry => {
    const entryCity = entry.data.city || '';
    const matchesName = entryCity.toLowerCase() === cityName.toLowerCase();
    const matchesFolder = entry.id.startsWith(`${city}/`);
    return matchesName || matchesFolder;
  })
  .sort((a, b) => {
    const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
    const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
    return dateB - dateA;
  });
---

<BaseLayout title={`${cityName} Real Estate & Local Market News | Arelys Catena`}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight mb-3">
        {cityName} Real Estate & Market Insights
      </h1>
      <p class="text-gray-600 text-base sm:text-lg">
        Browse our latest articles, guides, and market updates for {cityName}.
      </p>
    </header>

    {posts.length === 0 ? (
      <div class="text-center py-12 bg-white rounded-2xl shadow-sm border border-gray-200">
        <p class="text-gray-500 text-base">No updates available yet for {cityName}. Check back soon!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {posts.map((post) => {
          // Extract and format publication date cleanly
          const rawDate = post.data.pubDate;
          const formattedDate = rawDate
            ? new Date(rawDate).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                timeZone: 'UTC',
              })
            : null;

          // Strip file extensions to generate route slug
          const cleanSlug = post.id.replace(/\.[^/.]+$/, "");

          return (
            <article class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow flex flex-col justify-between">
              <div>
                {/* Date Display Badge */}
                {formattedDate && (
                  <div class="flex items-center gap-2 mb-3">
                    <span class="inline-flex items-center text-xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-50 text-[#C59B27] border border-amber-200">
                      <i class="fa-regular fa-calendar text-[10px] mr-1.5"></i>
                      Published {formattedDate}
                    </span>
                  </div>
                )}

                <h2 class="text-xl font-bold text-gray-900 mb-2 hover:text-[#C59B27] transition-colors leading-snug">
                  <a href={`/locations/${cleanSlug}`}>
                    {post.data.title}
                  </a>
                </h2>

                {post.data.description && (
                  <p class="text-gray-600 text-sm mb-4 line-clamp-2 leading-relaxed">
                    {post.data.description}
                  </p>
                )}
              </div>

              <div>
                <a
                  href={`/locations/${cleanSlug}`}
                  class="inline-flex items-center text-xs font-bold text-[#C59B27] hover:underline"
                >
                  Read Article <span class="ml-1">→</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </main>
</BaseLayout>