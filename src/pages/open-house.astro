---
const destinationUrl = 'https://arelystheamazingrealtor.com/properties/6420-nw-29th-st/?v=8d9eb77';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Register to receive access to Arelys Catena's open house information." />
    <title>Open House Registration | Arelys Catena</title>
  </head>
  <body>
    <main>
      <section class="intro" aria-labelledby="page-title">
        <div class="brand">
          <img src="/images/arelysphoto.webp" alt="Arelys Catena" />
          <div>
            <span>Arelys Catena</span>
            <small>Realtor®</small>
          </div>
          <strong>21</strong>
        </div>

        <div class="intro-copy">
          <p class="eyebrow">You’re invited</p>
          <h1 id="page-title">Welcome to the open house.</h1>
          <p class="lede">Please sign in below. Once you submit your information, you’ll be taken directly to the open house page.</p>
        </div>

        <div class="contact">
          <span>Questions before you begin?</span>
          <a href="tel:9542923366">(954) 292-3366</a>
          <a href="mailto:arelyshomes@gmail.com">arelyshomes@gmail.com</a>
        </div>
      </section>

      <section class="form-panel" aria-label="Open house registration form">
        <div class="form-heading">
          <p class="step">Open house sign-in</p>
          <h2>Tell me a little about yourself</h2>
          <p>Your information will not be shared.</p>
        </div>

        <form action="https://formsubmit.co/trevordavis74@gmail.com" method="POST">
          <input type="hidden" name="_subject" value="New open house registration" />
          <input type="hidden" name="_next" value={destinationUrl} />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input class="trap" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <label>
            <span>Full name</span>
            <input type="text" name="Full name" autocomplete="name" placeholder="Your first and last name" required />
          </label>

          <label>
            <span>Email address</span>
            <input id="email" type="email" name="Email" autocomplete="email" placeholder="you@example.com" aria-describedby="contact-help" />
          </label>

          <label>
            <span>Phone number</span>
            <input id="phone" type="tel" name="Phone" autocomplete="tel" placeholder="(555) 555-5555" aria-describedby="contact-help" />
          </label>

          <p id="contact-help" class="field-help">Please provide an email address or phone number. Both are welcome.</p>

          <fieldset>
            <legend>Are you currently working with a real-estate agent?</legend>
            <div class="options">
              <label class="option">
                <input type="radio" name="Working with an agent" value="Yes" required />
                <span>Yes</span>
              </label>
              <label class="option">
                <input type="radio" name="Working with an agent" value="No" required />
                <span>No</span>
              </label>
            </div>
          </fieldset>

          <button type="submit">
            Continue to the open house
            <span aria-hidden="true">→</span>
          </button>

          <p class="privacy">By continuing, you agree that Arelys Catena may contact you about this open house and related real-estate services.</p>
        </form>
      </section>
    </main>

    <script>
      const form = document.querySelector('form');
      const email = document.querySelector('#email');
      const phone = document.querySelector('#phone');

      if (form instanceof HTMLFormElement && email instanceof HTMLInputElement && phone instanceof HTMLInputElement) {
        const clearContactError = () => {
          email.setCustomValidity('');
          phone.setCustomValidity('');
        };

        email.addEventListener('input', clearContactError);
        phone.addEventListener('input', clearContactError);

        form.addEventListener('submit', (event) => {
          if (!email.value.trim() && !phone.value.trim()) {
            event.preventDefault();
            email.setCustomValidity('Please enter an email address or phone number.');
            email.reportValidity();
            email.focus();
          }
        });
      }
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    color: #111827;
    background: #f9fafb;
    font-family: Arial, Helvetica, sans-serif;
  }

  main {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(520px, 1.1fr);
  }

  .intro {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(2rem, 5vw, 5rem);
    color: #fff;
    background:
      radial-gradient(circle at 12% 88%, rgba(197, 155, 39, 0.22), transparent 32%),
      linear-gradient(145deg, #111827 0%, #1f2937 52%, #111827 100%);
  }

  .intro::after {
    content: '';
    position: absolute;
    width: 28rem;
    height: 28rem;
    right: -15rem;
    top: 20%;
    border: 1px solid rgba(197, 155, 39, 0.2);
    border-radius: 50%;
    box-shadow: 0 0 0 5rem rgba(197, 155, 39, 0.035), 0 0 0 10rem rgba(255, 255, 255, 0.018);
  }

  .brand, .intro-copy, .contact { position: relative; z-index: 1; }

  .brand { display: flex; align-items: center; gap: 0.9rem; }
  .brand img { width: 3.5rem; height: 3.5rem; border-radius: 50%; object-fit: cover; border: 2px solid #c59b27; }
  .brand span { display: block; font-size: 1.22rem; font-weight: 800; }
  .brand small { display: block; margin-top: 0.15rem; color: #d1d5db; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.11em; text-transform: uppercase; }
  .brand strong { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; margin-left: auto; border: 1px solid rgba(197, 155, 39, 0.7); border-radius: 50%; color: #c59b27; font-size: 0.82rem; letter-spacing: -0.05em; }

  .intro-copy { max-width: 38rem; padding: clamp(2.75rem, 8vh, 5rem) 0 2rem; }
  .eyebrow, .step { margin: 0 0 1rem; color: #c59b27; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; }
  h1 { margin: 0; max-width: 34rem; font-size: clamp(3rem, 6vw, 5.8rem); font-weight: 800; line-height: 0.98; letter-spacing: -0.045em; }
  .lede { max-width: 32rem; margin: 1.75rem 0 0; color: #e5e7eb; font-size: 1.08rem; line-height: 1.7; }

  .contact { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; color: #9ca3af; font-size: 0.82rem; }
  .contact a { color: #fff; text-decoration: none; }
  .contact a:hover { color: #c59b27; }

  .form-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 7vw, 7.5rem);
    background: #f9fafb;
  }

  .form-heading { max-width: 38rem; margin-bottom: 2.25rem; }
  .form-heading h2 { margin: 0 0 0.8rem; font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.035em; }
  .form-heading > p:last-child { margin: 0; color: #6b7280; line-height: 1.6; }

  form { width: 100%; max-width: 38rem; padding: clamp(1.4rem, 3vw, 2rem); border: 1px solid #e5e7eb; border-radius: 1rem; background: #fff; box-shadow: 0 18px 45px rgba(17, 24, 39, 0.08); }
  label > span, legend { display: block; margin-bottom: 0.55rem; color: #374151; font-size: 0.86rem; font-weight: 700; }
  form > label { display: block; margin-bottom: 1.15rem; }
  .field-help { margin: -0.35rem 0 1.5rem; color: #6b7280; font-size: 0.78rem; line-height: 1.45; }
  input[type='text'], input[type='email'], input[type='tel'] {
    width: 100%;
    padding: 0.95rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.75rem;
    color: #111827;
    background: #fff;
    font: inherit;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  input:focus { outline: none; border-color: #a68120; box-shadow: 0 0 0 3px rgba(197, 155, 39, 0.18); }
  input::placeholder { color: #9ca3af; }
  .trap { position: absolute !important; left: -9999px !important; }

  fieldset { margin: 1.5rem 0 1.75rem; padding: 0; border: 0; }
  .options { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  .option { position: relative; cursor: pointer; }
  .option input { position: absolute; opacity: 0; }
  .option span { margin: 0; padding: 0.85rem 1rem; border: 1px solid #d1d5db; border-radius: 0.75rem; text-align: center; transition: 160ms ease; }
  .option input:checked + span { color: #111827; border-color: #c59b27; background: #fffbeb; box-shadow: inset 0 0 0 1px #c59b27; }
  .option input:focus-visible + span { outline: 3px solid rgba(197, 155, 39, 0.3); outline-offset: 2px; }

  button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border: 0;
    border-radius: 0.75rem;
    color: #111827;
    background: #c59b27;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: transform 160ms ease, background 160ms ease;
  }
  button:hover { background: #d4aa36; transform: translateY(-1px); }
  button:focus-visible { outline: 3px solid rgba(197, 155, 39, 0.45); outline-offset: 3px; }
  button span { font-size: 1.2rem; }

  .privacy { margin: 1rem 0 0; color: #6b7280; font-size: 0.75rem; line-height: 1.5; text-align: center; }

  @media (max-width: 820px) {
    main { grid-template-columns: 1fr; }
    .intro { min-height: auto; }
    .intro-copy { padding: 2.75rem 0 2.25rem; }
    .form-panel { padding-top: 4rem; padding-bottom: 4rem; }
  }

  @media (max-width: 480px) {
    .intro { min-height: auto; padding: 1.5rem; }
    .intro-copy { padding: 2.5rem 0 2rem; }
    .contact { flex-direction: column; }
    .form-panel { padding: 3rem 1.5rem; }
  }
</style>
