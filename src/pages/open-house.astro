---
const destinationUrl = 'https://www.century21.com/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Register to receive access to Arelys Catena's open house information." />
    <title>Open House Registration | Arelys Catena</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main>
      <section class="intro" aria-labelledby="page-title">
        <div class="brand">
          <img src="/images/arelysphoto.webp" alt="Arelys Catena" />
          <div>
            <span>Arelys Catena</span>
            <small>South Florida Realtor</small>
          </div>
        </div>

        <div class="intro-copy">
          <p class="eyebrow">You’re invited</p>
          <h1 id="page-title">Welcome to the open house.</h1>
          <p class="lede">Please sign in below. Once you submit your information, you’ll be taken directly to the open house page.</p>
        </div>

        <div class="contact">
          <span>Questions before you begin?</span>
          <a href="tel:9542923366">(954) 292-3366</a>
          <a href="mailto:arelyshomes@gmail.com">arelyshomes@gmail.com</a>
        </div>
      </section>

      <section class="form-panel" aria-label="Open house registration form">
        <div class="form-heading">
          <p class="step">Open house sign-in</p>
          <h2>Tell me a little about yourself</h2>
          <p>All fields are required. Your information will only be used to follow up about your real-estate needs.</p>
        </div>

        <form action="https://formsubmit.co/arelyshomes@gmail.com" method="POST">
          <input type="hidden" name="_subject" value="New open house registration" />
          <input type="hidden" name="_next" value={destinationUrl} />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="true" />
          <input class="trap" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <label>
            <span>Full name</span>
            <input type="text" name="Full name" autocomplete="name" placeholder="Your first and last name" required />
          </label>

          <label>
            <span>Email address</span>
            <input type="email" name="Email" autocomplete="email" placeholder="you@example.com" required />
          </label>

          <label>
            <span>Phone number</span>
            <input type="tel" name="Phone" autocomplete="tel" placeholder="(555) 555-5555" required />
          </label>

          <fieldset>
            <legend>Are you currently working with a real-estate agent?</legend>
            <div class="options">
              <label class="option">
                <input type="radio" name="Working with an agent" value="Yes" required />
                <span>Yes</span>
              </label>
              <label class="option">
                <input type="radio" name="Working with an agent" value="No" required />
                <span>No</span>
              </label>
            </div>
          </fieldset>

          <button type="submit">
            Continue to the open house
            <span aria-hidden="true">→</span>
          </button>

          <p class="privacy">By continuing, you agree that Arelys Catena may contact you about this open house and related real-estate services.</p>
        </form>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    color: #17211d;
    background: #f3f0e8;
    font-family: 'DM Sans', sans-serif;
  }

  main {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(520px, 1.1fr);
  }

  .intro {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 5vw, 5rem);
    color: #fff;
    background:
      radial-gradient(circle at 15% 85%, rgba(197, 155, 39, 0.28), transparent 34%),
      linear-gradient(145deg, #13251d 0%, #254333 100%);
  }

  .intro::after {
    content: '';
    position: absolute;
    width: 28rem;
    height: 28rem;
    right: -15rem;
    top: 20%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    box-shadow: 0 0 0 5rem rgba(255, 255, 255, 0.025), 0 0 0 10rem rgba(255, 255, 255, 0.02);
  }

  .brand, .intro-copy, .contact { position: relative; z-index: 1; }

  .brand { display: flex; align-items: center; gap: 0.9rem; }
  .brand img { width: 3.5rem; height: 3.5rem; border-radius: 50%; object-fit: cover; border: 2px solid #d8b65b; }
  .brand span { display: block; font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 700; }
  .brand small { display: block; margin-top: 0.15rem; color: #d8cdb2; font-size: 0.75rem; letter-spacing: 0.11em; text-transform: uppercase; }

  .intro-copy { max-width: 38rem; padding: 5rem 0; }
  .eyebrow, .step { margin: 0 0 1rem; color: #d8b65b; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
  h1, h2 { font-family: 'Playfair Display', serif; }
  h1 { margin: 0; max-width: 34rem; font-size: clamp(3rem, 6vw, 5.8rem); line-height: 0.98; letter-spacing: -0.035em; }
  .lede { max-width: 32rem; margin: 1.75rem 0 0; color: #dce4df; font-size: 1.08rem; line-height: 1.7; }

  .contact { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; color: #b9c5be; font-size: 0.82rem; }
  .contact a { color: #fff; text-decoration: none; }
  .contact a:hover { color: #e6c66c; }

  .form-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 7vw, 7.5rem);
    background: #fff;
  }

  .form-heading { max-width: 38rem; margin-bottom: 2.25rem; }
  .form-heading h2 { margin: 0 0 0.8rem; font-size: clamp(2rem, 3.5vw, 3rem); line-height: 1.08; }
  .form-heading > p:last-child { margin: 0; color: #637069; line-height: 1.6; }

  form { width: 100%; max-width: 38rem; }
  label > span, legend { display: block; margin-bottom: 0.55rem; color: #28342e; font-size: 0.86rem; font-weight: 700; }
  form > label { display: block; margin-bottom: 1.15rem; }
  input[type='text'], input[type='email'], input[type='tel'] {
    width: 100%;
    padding: 0.95rem 1rem;
    border: 1px solid #ccd3cf;
    border-radius: 0.5rem;
    color: #17211d;
    background: #fbfcfb;
    font: inherit;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  input:focus { outline: none; border-color: #a68120; box-shadow: 0 0 0 3px rgba(197, 155, 39, 0.18); }
  input::placeholder { color: #939d97; }
  .trap { position: absolute !important; left: -9999px !important; }

  fieldset { margin: 1.5rem 0 1.75rem; padding: 0; border: 0; }
  .options { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  .option { position: relative; cursor: pointer; }
  .option input { position: absolute; opacity: 0; }
  .option span { margin: 0; padding: 0.85rem 1rem; border: 1px solid #ccd3cf; border-radius: 0.5rem; text-align: center; transition: 160ms ease; }
  .option input:checked + span { color: #173226; border-color: #c59b27; background: #fbf5e5; box-shadow: inset 0 0 0 1px #c59b27; }
  .option input:focus-visible + span { outline: 3px solid rgba(197, 155, 39, 0.3); outline-offset: 2px; }

  button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border: 0;
    border-radius: 0.5rem;
    color: #fff;
    background: #18382a;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: transform 160ms ease, background 160ms ease;
  }
  button:hover { background: #224c39; transform: translateY(-1px); }
  button:focus-visible { outline: 3px solid rgba(197, 155, 39, 0.45); outline-offset: 3px; }
  button span { font-size: 1.2rem; }

  .privacy { margin: 1rem 0 0; color: #7b8580; font-size: 0.75rem; line-height: 1.5; text-align: center; }

  @media (max-width: 820px) {
    main { grid-template-columns: 1fr; }
    .intro { min-height: 42rem; }
    .intro-copy { padding: 4rem 0; }
    .form-panel { padding-top: 4rem; padding-bottom: 4rem; }
  }

  @media (max-width: 480px) {
    .intro { min-height: 36rem; padding: 1.5rem; }
    .intro-copy { padding: 3.5rem 0 2.5rem; }
    .contact { flex-direction: column; }
    .form-panel { padding: 3rem 1.5rem; }
  }
</style>
