---
const thankYouUrl = 'https://arelystheamazingrealtor.com/brokers-open/thank-you/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Register for Arelys Catena's Broker's Open at 6420 NW 29th Street in Sunrise, Florida." />
    <title>Broker's Open Registration | Arelys Catena</title>
  </head>
  <body>
    <main>
      <section class="event" aria-labelledby="page-title">
        <div class="brand">
          <img src="/images/arelysphoto.webp" alt="Arelys Catena" />
          <div><span>Arelys Catena</span><small>Realtor®</small></div>
          <strong>21</strong>
        </div>

        <div class="event-copy">
          <p class="eyebrow">You’re invited</p>
          <h1 id="page-title"><span>Broker’s</span> Open</h1>
          <p class="script">Wine &amp; Cheese</p>

          <div class="details">
            <div><span class="icon" aria-hidden="true">⌖</span><p><strong>6420 NW 29th Street</strong><br />Sunrise, FL 33313</p></div>
            <div><span class="icon" aria-hidden="true">◷</span><p><strong>Thursday, October 22, 2026</strong><br />4–6 PM</p></div>
          </div>

          <div class="raffle"><strong>$100</strong><span>Gift-card raffle</span></div>

          <div class="event-images" aria-label="Broker's Open property photos">
            <div class="home-image" role="img" aria-label="Front exterior of 6420 NW 29th Street"></div>
            <div class="pool-image" role="img" aria-label="Pool and backyard at 6420 NW 29th Street"></div>
          </div>
        </div>

        <div class="contact">
          <span>Questions?</span>
          <a href="tel:9542923366">(954) 292-3366</a>
          <a href="mailto:arelyshomes@gmail.com">arelyshomes@gmail.com</a>
        </div>
      </section>

      <section class="form-panel" aria-label="Broker's Open registration form">
        <div class="form-heading">
          <p class="step">Broker registration</p>
          <h2>Reserve your spot</h2>
          <p>Register below to join us. Your information will not be shared.</p>
        </div>

        <form action="https://formsubmit.co/trevordavis74@gmail.com" method="POST">
          <input type="hidden" name="_subject" value="New Broker's Open registration — 6420 NW 29th Street" />
          <input type="hidden" name="_next" value={thankYouUrl} />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input class="trap" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <label><span>Full name</span><input type="text" name="Full name" autocomplete="name" placeholder="Your first and last name" required /></label>
          <label><span>Brokerage or company</span><input type="text" name="Brokerage or company" autocomplete="organization" placeholder="Your brokerage or company" required /></label>

          <div class="contact-fields">
            <label><span>Email address</span><input id="email" type="email" name="Email" autocomplete="email" placeholder="you@example.com" aria-describedby="contact-help" /></label>
            <label><span>Phone number</span><input id="phone" type="tel" name="Phone" autocomplete="tel" placeholder="(555) 555-5555" aria-describedby="contact-help" /></label>
          </div>

          <p id="contact-help" class="field-help">Please provide an email address or phone number. Both are welcome.</p>
          <button type="submit">Register for the Broker’s Open <span aria-hidden="true">→</span></button>
          <p class="privacy">By registering, you agree that Arelys Catena may contact you about this event and related real-estate opportunities.</p>
        </form>
      </section>
    </main>

    <script>
      const form = document.querySelector('form');
      const email = document.querySelector('#email');
      const phone = document.querySelector('#phone');

      if (form instanceof HTMLFormElement && email instanceof HTMLInputElement && phone instanceof HTMLInputElement) {
        const clearContactError = () => { email.setCustomValidity(''); phone.setCustomValidity(''); };
        email.addEventListener('input', clearContactError);
        phone.addEventListener('input', clearContactError);
        form.addEventListener('submit', (event) => {
          if (!email.value.trim() && !phone.value.trim()) {
            event.preventDefault();
            email.setCustomValidity('Please enter an email address or phone number.');
            email.reportValidity();
            email.focus();
          }
        });
      }
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; min-height: 100vh; color: #111827; background: #f7f7f5; font-family: Arial, Helvetica, sans-serif; }
  main { min-height: 100vh; display: grid; grid-template-columns: minmax(420px, .95fr) minmax(520px, 1.05fr); }
  .event { position: relative; overflow: hidden; display: flex; flex-direction: column; padding: clamp(2rem, 5vw, 5rem); color: #f9fafb; background: radial-gradient(circle at 90% 5%, rgba(197,155,39,.18), transparent 28%), radial-gradient(circle at 10% 92%, rgba(255,255,255,.06), transparent 31%), linear-gradient(145deg, #111827 0%, #26313f 52%, #171717 100%); }
  .event::before, .event::after { content: ''; position: absolute; border: 1px solid rgba(224,179,72,.42); border-radius: 50%; pointer-events: none; }
  .event::before { width: 28rem; height: 28rem; right: -17rem; top: 12%; box-shadow: 0 0 0 3rem rgba(224,179,72,.035); }
  .event::after { width: 20rem; height: 20rem; left: -13rem; bottom: -6rem; }
  .brand, .event-copy, .contact { position: relative; z-index: 1; }
  .brand { display: flex; align-items: center; gap: .9rem; }
  .brand img { width: 3.5rem; height: 3.5rem; border-radius: 50%; object-fit: cover; border: 2px solid #d9aa3d; }
  .brand span { display: block; font-size: 1.22rem; font-weight: 800; }
  .brand small { display: block; margin-top: .15rem; color: #eadfc8; font-size: .75rem; font-weight: 600; letter-spacing: .11em; text-transform: uppercase; }
  .brand strong { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; margin-left: auto; border: 1px solid rgba(224,179,72,.75); border-radius: 50%; color: #e0b348; font-size: .82rem; }
  .event-copy { max-width: 38rem; padding: clamp(2.75rem, 7vh, 4.5rem) 0 2.5rem; }
  .eyebrow, .step { margin: 0 0 1rem; color: #c79526; font-size: .75rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
  .event .eyebrow { color: #efc964; }
  h1 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(3.8rem, 7vw, 7rem); font-weight: 400; line-height: .82; letter-spacing: -.055em; text-transform: uppercase; }
  h1 span { display: block; color: #f9fafb; }
  .script { margin: 1.35rem 0 0; color: #efc964; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 4vw, 3.4rem); font-style: italic; }
  .details { display: grid; gap: 1rem; margin-top: 2.25rem; }
  .details > div { display: flex; align-items: center; gap: .9rem; }
  .details p { margin: 0; line-height: 1.5; }
  .icon { display: grid; flex: 0 0 2.65rem; width: 2.65rem; height: 2.65rem; place-items: center; border: 1px solid #d9aa3d; border-radius: 50%; color: #efc964; font-size: 1.2rem; }
  .raffle { display: inline-flex; align-items: center; gap: .8rem; margin-top: 2rem; padding: .8rem 1rem; border: 1px solid rgba(239,201,100,.58); border-radius: 999px; background: rgba(17,24,39,.58); }
  .raffle strong { color: #efc964; font-family: Georgia, 'Times New Roman', serif; font-size: 1.8rem; }
  .raffle span { font-size: .82rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  .event-images { display: grid; grid-template-columns: 1.6fr 1fr; gap: .75rem; margin-top: 1.4rem; }
  .event-images > div { min-height: 8.5rem; border: 1px solid rgba(239,201,100,.5); border-radius: .85rem; background-image: url('/images/brokers-open-flyer.png'); background-repeat: no-repeat; background-size: 100% auto; box-shadow: 0 12px 30px rgba(0,0,0,.2); }
  .home-image { background-position: center 52%; background-size: 115% auto !important; }
  .pool-image { background-position: 100% 88%; background-size: 300% auto !important; }
  .contact { display: flex; flex-wrap: wrap; gap: .55rem 1.2rem; margin-top: auto; color: #d8cbb8; font-size: .82rem; }
  .contact a { color: #fff; text-decoration: none; }
  .contact a:hover { color: #efc964; }
  .form-panel { display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 7vw, 7rem); background: #f7f7f5; }
  .form-heading { max-width: 38rem; margin-bottom: 2rem; }
  .form-heading h2 { margin: 0 0 .8rem; color: #111827; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2.4rem, 4vw, 3.5rem); font-weight: 500; line-height: 1; letter-spacing: -.035em; }
  .form-heading > p:last-child { margin: 0; color: #6b7280; line-height: 1.6; }
  form { width: 100%; max-width: 38rem; padding: clamp(1.4rem, 3vw, 2rem); border: 1px solid #e5e7eb; border-radius: 1rem; background: #fff; box-shadow: 0 18px 45px rgba(17,24,39,.09); }
  label > span { display: block; margin-bottom: .55rem; color: #374151; font-size: .86rem; font-weight: 700; }
  form > label { display: block; margin-bottom: 1.15rem; }
  .contact-fields { display: grid; grid-template-columns: 1fr 1fr; gap: .85rem; }
  .field-help { margin: .55rem 0 1.5rem; color: #6b7280; font-size: .78rem; line-height: 1.45; }
  input[type='text'], input[type='email'], input[type='tel'] { width: 100%; padding: .95rem 1rem; border: 1px solid #d1d5db; border-radius: .75rem; color: #111827; background: #fff; font: inherit; transition: border-color 160ms ease, box-shadow 160ms ease; }
  input:focus { outline: none; border-color: #b78317; box-shadow: 0 0 0 3px rgba(199,149,38,.18); }
  input::placeholder { color: #aaa197; }
  .trap { position: absolute !important; left: -9999px !important; }
  button { width: 100%; display: flex; align-items: center; justify-content: center; gap: .75rem; padding: 1rem 1.25rem; border: 0; border-radius: .75rem; color: #111827; background: #c59b27; font: inherit; font-weight: 800; cursor: pointer; transition: transform 160ms ease, background 160ms ease; }
  button:hover { background: #d4aa36; transform: translateY(-1px); }
  button:focus-visible { outline: 3px solid rgba(199,149,38,.5); outline-offset: 3px; }
  button span { color: #efc964; font-size: 1.2rem; }
  .privacy { margin: 1rem 0 0; color: #6b7280; font-size: .75rem; line-height: 1.5; text-align: center; }
  @media (max-width: 880px) { main { grid-template-columns: 1fr; } .event { min-height: auto; } .event-copy { padding: 3rem 0; } .contact { margin-top: 0; } .form-panel { padding-top: 4rem; padding-bottom: 4rem; } }
  @media (max-width: 560px) { .event { padding: 1.5rem; } .event-copy { padding: 2.5rem 0; } .contact { flex-direction: column; } .form-panel { padding: 3rem 1.25rem; } .contact-fields { grid-template-columns: 1fr; } .event-images { grid-template-columns: 1fr; } .event-images > div { min-height: 10rem; } }
</style>

